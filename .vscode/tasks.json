{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest tests",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test-core",
      "type": "shell",
      "command": "uv run pytest tests/core -p no:homeassistant",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "uv run ruff check custom_components tests && uv run ruff format --check .",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
